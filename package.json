{
  "name": "marko-project",
  "private": true,
  "scripts": {
    "@ci:build": "pnpm run build",
    "@ci:lint": "oxlint && oxfmt --check --with-node-modules .",
    "@ci:release": "pnpm run build && node scripts/pkg-override && changeset publish && pnpm run @ci:release-alias && node scripts/pkg-override && pnpm install --frozen-lockfile",
    "@ci:release-alias": "node -r ~ts scripts/publish-alias.mts",
    "@ci:test": "zcov -- pnpm run @ci:test:fast",
    "@ci:test:fast": "pnpm run test",
    "@ci:version": "changeset version && pnpm install --lockfile-only",
    "audit": "pnpm audit --prod",
    "build": "pnpm -r --if-present run build && pnpm run build:types",
    "build:sizes": "node -r ~ts scripts/sizes.mts",
    "build:types": "tsc -b tsconfig.build.json",
    "change": "changeset add",
    "compile": "node -r ~ts scripts/inspect-compiled-output.mts",
    "format": "oxlint --fix; oxfmt --with-node-modules .",
    "lint": "oxlint && oxfmt --check --with-node-modules .",
    "prepare": "husky && pnpm --filter @marko/compiler run build-babel-types",
    "report": "zcov report -r html && node -p \"require('node:url').pathToFileURL('coverage/index.html').href\"",
    "test": "node scripts/test-parallel.js",
    "test:serial": "mocha --config .mocharc.all.cjs",
    "test:update": "UPDATE_EXPECTATIONS=1 node scripts/test-parallel.js",
    "test:update:serial": "UPDATE_EXPECTATIONS=1 mocha --config .mocharc.all.cjs"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/code-frame": "^7.29.0",
    "@babel/core": "^7.29.0",
    "@babel/generator": "^7.29.12",
    "@babel/parser": "^7.29.12",
    "@babel/plugin-syntax-typescript": "^7.28.6",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@babel/preset-env": "^7.29.5",
    "@babel/traverse": "^7.29.12",
    "@babel/types": "^7.29.11",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@ebay/browserslist-config": "^2.16.0",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@marko/compiler": "workspace:*",
    "@types/babel__code-frame": "^7.27.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/js-beautify": "^1.14.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@zcov/cli": "^0.1.4",
    "babel-plugin-minprops": "^2.0.1",
    "husky": "^9.1.7",
    "js-beautify": "^2.0.3",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "mocha-autotest": "^1.1.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "pretty-format": "^30.5.1",
    "resolve-sync": "^1.2.2",
    "rolldown": "^1.2.16",
    "table": "^6.10.1",
    "typescript": "^7.0.2",
    "~ts": "file:scripts/ts-hooks"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.15.1"
}
