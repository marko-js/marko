{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "__snapshots__",
    ".sizes",
    ".sizes.json",
    "*expected*",
    "~*",
    "CHANGELOG.md",
    "**/fixtures/*/*",
    "!**/fixtures/*/*.ts",
    "!packages/runtime-tags/src/__tests__/fixtures/*/*",
    "packages/runtime-tags/src/__tests__/fixtures/*/*/*",
    "!packages/runtime-tags/src/__tests__/fixtures/*/*/*.ts",
    "input.*",
    "pnpm-lock.yaml",
    "snapshots"
  ]
}
