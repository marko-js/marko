import Child from "./tags/child.marko";
import Other from "./tags/other.marko";
<let/useChild=true/>
<for|outer| of=[0, 1]>
  <let/l=[{ name: "a" }, { name: "b" }, { name: "c" }]/>
  <let/short=false/>
  <${useChild ? Child : Other}/r v=short/>
  <for|i| from=0 to=(r ? 0 : l.length - 1)>
    <span>${l[i].name}</span>
  </for>
  <button onClick() { short = true; l = [{ name: "z" }] }>go</button>
</for>
