import { getItems, getNote } from "./data";

<let/count=0/>
<button.count onClick() { count++ }>clicked ${count}</button>

<define/PanelA>
  <p.a>${getNote?.("a", $global.topic)}</p>
</define>
<define/PanelB>
  <p.b>${getNote?.("b", $global.topic)}</p>
</define>

<${$global.view === "b" ? PanelB : PanelA}/>

<if=$global.alert>
  <p.alert>attention needed</p>
</if>
<else>
  <p.calm>all clear</p>
</else>

<ul.items>
  <for|item| of=getItems?.($global.range) by(item) { return item.id }>
    <li>${item.name}</li>
  </for>
</ul>
