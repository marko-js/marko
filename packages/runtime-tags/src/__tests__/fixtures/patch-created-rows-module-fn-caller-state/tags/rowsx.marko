import { lib } from "./lib";
<let/open=true/>
<define/Panel|{ isOpen, fmt, label }|>
  <if=isOpen>
    <em>${fmt(label)}</em>
  </if>
</define>
<for|x| of=input.items>
  <Panel isOpen=input.open fmt=lib.format label=input.label + x/>
</for>
<if=open>
  <b>${input.label}</b>
</if>
<button.toggle onClick() { open = !open }>toggle</button>
