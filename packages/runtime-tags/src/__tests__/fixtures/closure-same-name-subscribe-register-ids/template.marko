import { resolveAfter } from "../../utils/resolve";

<let/x=1/>
<const/z=x/>
<button.x onClick() { x++ }>${x}</button>
<wrap>
  <let/x=10/>
  <button.y onClick() { x++ }/>
  <try>
    <@placeholder>loading</@placeholder>
    <await|v|=resolveAfter(1, 1)>
      <i>${z}</i>
      <b>${x}</b>
    </await>
  </try>
  <wrap><s>${x}</s></wrap>
</wrap>
