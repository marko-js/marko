<let/upper=false/>
<const/up=() => "U" + input.title/>
<const/low=() => "l" + input.title/>
<define/Show|{ get }|>
  <const/g=get ?? (() => "none")/>
  <output/el/>
  <script>el().textContent = g(); console.log("run", g())</script>
</define>
<Show get=(upper ? up : low)/>
<button onClick() { upper = !upper }>toggle</button>
