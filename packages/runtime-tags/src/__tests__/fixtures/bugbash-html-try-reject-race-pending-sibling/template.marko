import { resolveAfter, rejectAfter } from "../../utils/resolve";
-- before
<try>
  <@catch|err|>CAUGHT:${err.message}</@catch>
  a
  <await|v|=resolveAfter("slow", 2)>${v}</await>
  b
  <try>
    <@catch|e|>INNER:${e.message}</@catch>
    <await|v|=resolveAfter("inner-slow", 3)>${v}</await>
  </try>
  c
  <await|v|=rejectAfter(new Error("boom"), 1)>${v}</await>
  d
</try>
-- after
