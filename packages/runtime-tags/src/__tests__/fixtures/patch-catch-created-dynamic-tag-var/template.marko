import Big from "./tags/huge-label.marko";
import Small from "./tags/tiny-label.marko";
static function boom(): never {
  throw new Error("SHOWN_message");
}
<try>
  <p>${input.fail ? boom() : "ok"}</p>
  <@catch|err|>
    <b>${(err as Error).message}</b>
    <${input.big ? Big : Small}/v label=input.label/>
    <i>${v}</i>
  </@catch>
</try>
