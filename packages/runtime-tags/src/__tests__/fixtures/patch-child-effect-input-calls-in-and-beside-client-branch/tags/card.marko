<let/open=true/>
<define/Panel|{ isOpen, fmt, label }|>
  <if=isOpen>
    <em>${fmt(label)}</em>
  </if>
</define>
<Panel isOpen=true fmt=input.fmt label=input.label/>
<if=input.show>
  <Panel isOpen=input.open fmt=input.fmt label=input.label/>
</if>
<if=open>
  <b>${input.label}</b>
</if>
<script>
  console.log("label", input.label);
</script>
<button.toggle onClick() { open = !open }>toggle</button>
