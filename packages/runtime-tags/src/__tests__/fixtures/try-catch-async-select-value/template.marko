import { rejectAfter } from "../../utils/resolve";

<select value="b">
  <option value="a">A</option>
  <try>
    <await|v| = rejectAfter(new Error("x"), 1)>
      <option value=v>async ${v}</option>
    </await>
    <@catch>
      <option value="b">catch b</option>
    </@catch>
  </try>
</select>
