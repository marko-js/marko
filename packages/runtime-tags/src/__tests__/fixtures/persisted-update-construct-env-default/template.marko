static const selected = typeof window === "undefined" ? "pro" : "basic";

<let/n=0/>
<button.n onClick() { n++ }>clicked ${n}</button>
<if=input.show>
  <input.pro type="radio" name="plan" value="pro" checkedValue=selected>
  <input.basic type="radio" name="plan" value="basic" checkedValue=selected>
</if>
