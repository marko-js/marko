import { resolveAfter } from "../../utils/resolve";

<let/value=0/>
<try>
  <@placeholder>outer</@placeholder>
  <await|a|=resolveAfter(1, 3)>
    <button onClick() { value++ }>${value}</button>
  </await>
  <try>
    <@placeholder>inner</@placeholder>
    <await|b|=resolveAfter(2, 2)>
      <button onClick() { value++ }>${value}</button>
    </await>
    <button onClick() { value++ }>${value}</button>
  </try>
</try>
<await|c|=resolveAfter(3, 1)>
  <button onClick() { value++ }>${value}</button>
</await>
