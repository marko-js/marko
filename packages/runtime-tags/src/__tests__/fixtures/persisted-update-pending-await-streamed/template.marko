import { resolveAfter } from "../../utils/resolve";

// The click handler's only purpose is giving the root scope a resumable
// effect: the harness's live-root pairing trick (main.test.ts's
// `onNavigate`, mirroring `getUpdateRoot` in dom/resume.ts) replays
// scope 1's own resume entry, which needs at least one to exist -- and
// doubles as the client state whose survival across the multi-frame apply
// this fixture pins.
<let/clicks=0/>
<button.clicks onClick() { clicks++ }>clicked ${clicks}</button>
<section>
  <try>
    <@placeholder>loading…</@placeholder>
    <await|note|=resolveAfter(input.note, input.tick)>
      <p>${note}</p>
    </await>
  </try>
</section>
