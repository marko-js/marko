// Client state keeps this template membrane-live: its lazy module (the
// escape-anchor loader path under test) stays required for updates.
<let/pinned=0/>
<button.pin onClick() { pinned++ }>pin ${pinned}</button>
<ol.lineup>
  <for|name| of=input.performers by(name) { return name }>
    <li>${name}</li>
  </for>
</ol>
