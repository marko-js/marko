import { getData } from "./data";

<let/count=0/>
<button.count onClick() { count++ }>clicked ${count}</button>

<define/Home>
  <p.home>home</p>
</define>
<define/Reports>
  <try>
    <@placeholder>
      <p.loading>loading…</p>
    </@placeholder>
    <await|data|=getData($global.range)>
      <let/ready=false/>
      // `mounter` is a dom-less child (only a `<lifecycle>`), so its scope
      // gets live identity ONLY from the boundary-body entry's serialized
      // scope-id list -- the exact wiring this fixture's corrupted
      // navigations attack.
      <mounter onReady() { ready = true }/>
      <p.status>${ready ? "ready" : "waiting"} of ${data.total}</p>
    </await>
  </try>
</define>

<layout content=$global.view === "reports" ? Reports : Home/>
