import { rejectAfter, resolveAfter } from "../../utils/resolve";
import Child from "./child.marko" with { load: "render" }

<div id="log"/>
<log-effect id="before"/>
<try>
  <Child/>
  <try>
    <@placeholder>
      <log-effect id="placeholder"/>
    </@placeholder>
    <await|v| = resolveAfter("inner", 3)>
      ${v}
    </await>
  </try>
  <await|v| = rejectAfter(new Error("ERROR!"), 2)>
    ${v}
  </await>
  <@catch|err|>
    ${err.message}
  </@catch>
</try>
<log-effect id="after"/>
