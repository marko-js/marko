<let/open=false/>
<define/Panel|{ isOpen, label, hidden }|>
  <if=isOpen && !hidden>
    <em>${label}</em>
  </if>
</define>
<if=input.show>
  <Panel isOpen=input.open label=input.label/>
</if>
<const/Tag=input.other ? "div" : Panel/>
<${Tag} isOpen=!open label=input.label + "!" hidden=input.hidden/>
<button onClick() { open = !open }>toggle</button>
