<let/count=0/>
<define/Panel|{ open, body }|>
  <if=open>
    <${body}/>
  </if>
</define>
<main>
  <Panel open=(count % 2 === 0)>
    <@body><em>${input.title}</em></@body>
  </Panel>
  <Panel open=input.open>
    <@body><strong>${input.title}</strong></@body>
  </Panel>
  <button onClick() { count++ }>+</button>
</main>
