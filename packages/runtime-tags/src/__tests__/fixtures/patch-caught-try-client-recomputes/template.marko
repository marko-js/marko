static function boom(message: string): never {
  throw new Error(message);
}
<try>
  <p>${input.early ? boom("early") : "ok"}</p>
  <@catch|err|>
    <b>${input.label + (err as Error).message}</b>
    <child/text label=input.label count=input.count/>
    <i>${text}</i>
  </@catch>
</try>
<try>
  <p>${input.late ? boom("late") : "ok"}</p>
  <@catch|err|>
    <b>${input.label + (err as Error).message}</b>
    <child/text label=input.label count=input.count/>
    <i>${text}</i>
  </@catch>
</try>
<script>document.body.dataset.ready = "1"</script>
