import Card from "./tags/card.marko";
<main>
  <await|v|=input.v>
    <${input.outer ? Card : "div"}>
      <await|w|=input.w>
        <b>${w}</b>
        <script>console.log("w", w)</script>
        <${input.inner ? Card : "section"}><em>${input.note} ${w}</em></>
      </await>
    </>
  </await>
</main>
