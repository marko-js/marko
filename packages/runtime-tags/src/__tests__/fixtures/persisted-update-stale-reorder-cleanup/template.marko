import { resolveAfter } from "../../utils/resolve";

// The click handler gives the root scope a resumable effect; the harness's
// live-root pairing replays scope 1's resume entry, which needs one to exist.
<let/n=0/>
<h1 onClick() { n++ }>${input.heading}</h1>
<main>
  <try>
    <@placeholder>fetching…</@placeholder>
    <await|value|=resolveAfter(input.value, input.tick)>
      <b>${value}</b>
    </await>
  </try>
</main>
