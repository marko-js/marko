// `rest` is only read inside the handler; its scope slot must hold the current value.
<let/state={ a: 1, b: 2 }/>
<const/{ a, ...rest }=state/>
<let/log=""/>

<button.bump onClick() { state = { a: state.a + 1, b: state.b + 1 }; }>bump</button>
<button.show onClick() { log = JSON.stringify(rest); }>show</button>

<div.a>${a}</div>
<div.log>${log}</div>
