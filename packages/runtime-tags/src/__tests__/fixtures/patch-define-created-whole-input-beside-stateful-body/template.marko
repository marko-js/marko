<let/open=false/>
<define/Panel|attrs|>
  <if=attrs.isOpen>
    <for|it| of=attrs.item>
      <em>${it.label}</em>
    </for>
    <span>${Object.keys(attrs).length}</span>
  </if>
</define>
<if=input.show>
  <Panel isOpen=true>
    <if=true>
      <@item label="x"/>
    </if>
  </Panel>
</if>
<const/Tag=input.other ? "div" : Panel/>
<${Tag} isOpen=!open>
  <@item label=input.label + "!"/>
</>
<button onClick() { open = !open }>toggle</button>
