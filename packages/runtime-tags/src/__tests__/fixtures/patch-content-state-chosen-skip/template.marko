static let contentRenders = 0;
static function rendering() {
  contentRenders++;
  return "";
}
static function takeRenders() {
  const renders = contentRenders;
  contentRenders = 0;
  return renders;
}

<let/mode=false/>
<button onClick() { mode = !mode }>toggle</button>
<define/one>
  <em>one ${input.b}${rendering()}</em>
</define>
<define/two>
  <strong>two ${input.b}${rendering()}</strong>
</define>
<section content=(mode ? one : two)/>
<const/attrs={ class: input.b, content: mode ? one : two }/>
<section ...attrs/>
<section ...attrs id="partial"/>
<const/status=`${input.b}: ${takeRenders()} content renders`/>
<script>console.log(status)</script>
