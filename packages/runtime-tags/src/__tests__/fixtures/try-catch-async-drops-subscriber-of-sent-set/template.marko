import { rejectAfter, resolveAfter } from "../../utils/resolve";

<define/Item>
  <span/el>x</span>
</define>
<Item/>
<await|a| = resolveAfter("a", 3)>${a}</await>
<try>
  <await|v| = resolveAfter(1, 1)>
    <Item/>
  </await>
  <await|v| = rejectAfter(new Error("ERROR!"), 2)>${v}</await>
  <@catch|err|>caught ${err.message}</@catch>
</try>
<script>
  for (const e of el) e.textContent = "y";
</script>
