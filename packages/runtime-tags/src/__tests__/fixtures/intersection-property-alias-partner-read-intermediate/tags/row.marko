static function feed(inc: { status: string; pending?: boolean }, sfx: string) {
  return { status: inc.status, label: inc.status + sfx };
}

<let/sfx="!"/>
<const/item=feed(input.inc, sfx)/>
<const/upper=item.status.toUpperCase()/>
<span class=[upper, input.inc.pending && "pending"]/>
<script>
  console.log(item.status);
</script>
