import Large from "./tags/large-label.marko";
import Small from "./tags/small-label.marko";

static function boom(error: unknown): never {
  throw error;
}
<let/count=0/>
<button onClick() { count++ }>${count}</button>
<try>
  <p>${input.error ? boom(input.error) : "ok"}</p>
  <@catch|err|>
    <${input.large ? Large : Small}
      message=(err as Error).message
      count=count
      label=input.label
    />
  </@catch>
</try>
