export interface Input {
  status: string;
  workspaces: { id: string; name: string }[];
}
<let/selectedId="a">
<let/openIds=["a"]>
<const/open=(id: string) => {
  selectedId = id;
  if (!openIds.includes(id)) openIds = openIds.concat(id);
}>
<lifecycle
  onMount() {
    console.log("shell mounted", input.status, rootEl().dataset.status);
    const abort = new AbortController();
    // Shell-level router: one document listener, like a real app shell.
    document.addEventListener("click", (e) => {
      if (e.defaultPrevented) return;
      const a = (e.target as Element).closest("a[href]");
      if (!a) return;
      e.preventDefault();
      open(a.getAttribute("href")!.slice(1));
    }, { capture: true, signal: abort.signal });
    return { abort };
  }
  onDestroy() {
    console.log("shell destroyed", input.status);
    this.abort.abort();
  }
/>
<div/rootEl data-status=input.status>
  <a href="#b">open b</a>
  <for|id| of=openIds by=(id) => id>
    <const/ws=input.workspaces.find((w) => w.id === id)>
    <if=ws>
      <child workspace=ws active=(ws.id === selectedId)/>
    </if>
  </for>
</div>
