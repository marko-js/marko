<define/Outer|input|>
  <define/Inner|inner|>
    <Outer depth=inner.depth content=inner.content/>
  </define>
  <let/shown=false/>
  <const/label=shown ? "on" : "off"/>
  <button onClick() { shown = !shown }>${input.depth}</button>
  <if=shown><${input.content}/></if>
  <if=input.depth < 1>
    <Inner depth=input.depth + 1><em>held ${label}</em></Inner>
  </if>
</define>
<Outer depth=0/>
