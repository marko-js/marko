static function rendered(id) {
  console.log(`row ${id}`);
  return true;
}
<let/selected=1/>
<let/rows=[{ id: 1, label: "a" }, { id: 2, label: "b" }, { id: 3, label: "c" }]/>
<if=rows.length>
  <ul>
    <for|row| of=rows by="id">
      <li class=(rendered(row.id) && selected === row.id && "danger")>
        <button.select onClick() { selected = row.id }>${row.label}</button>
      </li>
    </for>
  </ul>
</if>
<button.add onClick() { rows = [...rows, { id: rows.length + 1, label: "n" }] }>add</button>
<button.clear onClick() { rows = [] }>clear</button>
