<let/open=false/>
<define/Panel|{ isOpen, ...rest }|>
  <if=isOpen>
    <em ...rest>${Object.keys(rest).join()}</em>
  </if>
</define>
<if=input.show>
  <Panel isOpen=input.open title="x"/>
</if>
<const/Tag=input.other ? "div" : Panel/>
<${Tag} isOpen=!open title=input.label + "!"/>
<button onClick() { open = !open }>toggle</button>
