<let/open=false/>
<button onClick() { open = !open }>toggle</button>
<define/Panel|{ isOpen, label }|>
  <if=isOpen>
    <em>${label}</em>
  </if>
</define>
<if=input.show>
  <const/x=input.label + "?"/>
  <let/n=1/>
  <Panel isOpen=input.open label=x/>
  <Panel isOpen=true label=n/>
  <button onClick() { n++ }>inc</button>
</if>
<const/Tag=input.other ? "div" : Panel/>
<${Tag} isOpen=!open label=input.label + "!"/>
