<define/Panel>
  <let/hits=0/>
  <button.hit onClick() { hits++ }>hits ${hits}</button>
</define>
<define/Badge>
  <span.badge>badge</span>
</define>

<let/count=0/>
<button.count onClick() { count++ }>clicked ${count}</button>
<if=input.show>
  <let/n=0/>
  <button.tap onClick() { n++ }>tap ${n}</button>
  <div.host content=Panel/>
  <div.aside content=Badge/>
</if>
