import { resolveAfter } from "../../utils/resolve";
import Thrower from "./thrower.marko" with { load: "render" }

<await|a| = resolveAfter("a", 3)>
  ${a}
</await>
<try>
  <await|b| = resolveAfter("b", 1)>
    <Thrower/>
    <await|c| = resolveAfter("c", 3)>
      ${c}
    </await>
  </await>
  <@catch|err|>
    caught ${err.message}
  </@catch>
</try>
