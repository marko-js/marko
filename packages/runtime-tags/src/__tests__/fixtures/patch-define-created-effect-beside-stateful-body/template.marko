<let/open=false/>
<define/Panel|{ isOpen, label }|>
  <if=isOpen><em>${label}</em></if>
  <script>console.log("effect", label)</script>
</define>
<if=input.show>
  <Panel isOpen=input.open label="k"/>
  <Panel isOpen=true label=input.label/>
</if>
<const/Tag=input.other ? "div" : Panel/>
<${Tag} isOpen=!open label="dyn"/>
<button id="t" onClick() { open = !open }>toggle</button>
