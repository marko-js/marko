<let/n=0/>
<main>
  <try>
    <await|value|=input.promise>
      <em>${value}</em>
    </await>
    <@placeholder>
      <p>loading</p>
      <if=n>
        <b>ph ${n}</b>
        <script>
          const main = document.querySelector("main")!;
          main.dataset.ph = String(+(main.dataset.ph || 0) + 1);
        </script>
      </if>
    </@placeholder>
  </try>
  <button onClick() { n++ }>${n}</button>
</main>
