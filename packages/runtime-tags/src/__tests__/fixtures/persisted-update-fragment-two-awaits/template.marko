import { getReport, getSummary } from "./data";

<let/count=0/>
<button.count onClick() { count++ }>clicked ${count}</button>

<define/Home>
  <p.home>welcome home</p>
</define>
<define/Reports>
  // Two pending awaits in one placeholder boundary body cannot be placed by
  // the applier, so the fragment capture must abort into the fallback.
  <try>
    <@placeholder>
      <p.loading>loading…</p>
    </@placeholder>
    <await|report|=getReport($global.topic)>
      <p.report>${report}</p>
    </await>
    <await|summary|=getSummary($global.topic)>
      <p.summary>${summary}</p>
    </await>
  </try>
</define>

<${$global.view === "reports" ? Reports : Home}/>
