import { rejectAfter, resolveAfter } from "../../utils/resolve";
import Child from "./child.marko" with { load: "render" }

<try>
  <@placeholder>loading</@placeholder>
  <await|v| = resolveAfter("body", 1)>
    <Child value=v/>
  </await>
  <await|v| = rejectAfter(new Error("ERROR!"), 1)>${v}</await>
  <@catch|err|>
    <Child value="catch"/>
    caught ${err.message}
  </@catch>
</try>
