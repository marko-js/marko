import { rejectAfter, resolveAfter } from "../../utils/resolve";

<let/count=0/>
<let/show=true/>
<pre id="log"/>
<button.inc onClick() { count++ }>${count}</button>
<button.hide onClick() { show = false }/>
<if=show>
  <try>
    <await|v| = resolveAfter(1, 1)>
      <try>
        <await|x| = rejectAfter(new Error("nope"), 2)>${v}${x}</await>
        <@placeholder>loading</@placeholder>
      </try>
    </await>
    <@placeholder>outer loading</@placeholder>
    <@catch|err|>
      <span>${count}</span>
      <script>
        document.getElementById("log").textContent += "[" + count + "]";
      </script>
    </@catch>
  </try>
</if>
