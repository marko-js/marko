import { resolveAfter } from "../../utils/resolve";

<try>
  <@placeholder>outer loading</@placeholder>
  <@catch|err|>caught ${err.message}</@catch>
  <try>
    <@placeholder>
      inner loading ${(() => { throw new Error("inner placeholder") })()}
    </@placeholder>
    <await|x|=resolveAfter("inner", 1)>
      <span>${x}</span>
    </await>
  </try>
  <await|y|=resolveAfter("outer", 2)>
    <div>${y}</div>
  </await>
</try>
