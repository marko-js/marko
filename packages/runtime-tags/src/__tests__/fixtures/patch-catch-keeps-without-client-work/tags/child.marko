static function boom(msg: string): never {
  throw new Error(msg);
}
<p>${input.n}</p>
<try>
  <p>${input.early ? boom("early") : "ok"}</p>
  <@catch|err|><b>${$global.label} ${input.label} ${(err as Error).message}</b></@catch>
</try>
<try>
  <p>${input.late ? boom("late") : "ok"}</p>
  <@catch|err|><b>${$global.label} ${input.label} ${(err as Error).message}</b></@catch>
</try>
