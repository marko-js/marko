import { resolveAfter } from "../../utils/resolve";

// The click handler's only purpose is giving the root scope a resumable
// effect: the harness's live-root pairing trick (main.test.ts's
// `onNavigate`) replays scope 1's own resume entry, which needs at least
// one to exist -- and doubles as client state the corrupted navigation must
// leave untouched.
<let/clicks=0/>
<button.clicks onClick() { clicks++ }>clicked ${clicks}</button>
<section>
  <try>
    <@placeholder>loading…</@placeholder>
    <await|note|=resolveAfter(input.note, input.tick)>
      <let/taps=0/>
      <button.taps onClick() { taps++ }>${note} tapped ${taps}</button>
    </await>
  </try>
</section>
