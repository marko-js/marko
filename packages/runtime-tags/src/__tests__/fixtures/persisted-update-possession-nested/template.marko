import { getLabel } from "./data";

<let/count=0/>
<button.count onClick() { count++ }>clicked ${count}</button>

<define/PanelA>
  <p.a>Panel A: ${getLabel?.($global.topic)}</p>
</define>
<define/PanelB>
  <section.b>Panel B: ${getLabel?.($global.topic)}</section>
</define>

<define/Page>
  <h3.page-heading>Page</h3>
  <${$global.view === "b" ? PanelB : PanelA}/>
</define>

<shell content=Page/>
