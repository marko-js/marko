<let/selected=1/>
<let/rows=[{ id: 1, label: "a" }, { id: 2, label: "b" }, { id: 3, label: "c" }, { id: 4, label: "d" }]/>
<ul#list>
  <for|row| of=rows by="id">
    <li class=(selected === row.id && "sel")>${row.label}</li>
  </for>
</ul>
<button#sel2 onClick() { selected = 2 }>sel2</button>
<button#batch onClick() {
  // reorder + remove currently selected + select an existing kept row
  rows = [rows[3], rows[2], rows[0]]; // d, c, a (removes b, the selected row)
  selected = 3;
}>batch</button>
<button#swap onClick() {
  // select a different row AND move both affected rows in one batch
  selected = 4;
  rows = [...rows].reverse();
}>swap</button>
