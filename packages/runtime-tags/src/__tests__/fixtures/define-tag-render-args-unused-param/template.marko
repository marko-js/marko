<let/x=1 />
<define/MyTag|a, b, c|>
  <div>${b}|${c}</div>
</define>
<define/Wrap|a, opts|>
  <p><${opts.content}/></p>
</define>
<define/Titled|a, opts|>
  <h1>${opts.title}</h1>
</define>

<MyTag(1, "Hello", x) />
<Wrap(x)>${x}</Wrap>
<Titled(x)>unread</Titled>
<button onClick() { x++; }>
  ${x}
</button>
