// The loop reads `id` lazily through `todo`, which the server writes for
// `whole`, optional as `id`'s forward was, since `clear` nulls it; `nick` and
// `name` keep their own, which the effect reads live, `name` through `shown`.
<let/todo={ id: 1 }/>
<let/user={ nick: "n", name: "u" }/>
<const/{ nick, name }=user/>
<const/shown=name/>
<let/log=""/>

<script>console.log(`${nick} ${shown}`)</script>
<button.whole onClick() { log = `${log}${JSON.stringify(todo)}`; }>whole</button>
<button.clear onClick() { todo = null; }>clear</button>
<button.copy onClick() { user = { ...user }; }>copy</button>
<button.shown onClick() { log = `${log}(${shown})`; }>shown</button>
<for|n| of=[1]>
  <const/{ id }=todo/>
  <button.item onClick() { log = `${log}[${id}:${nick}:${name}:${shown}]`; }>item</button>
</for>

<div.log>${log}</div>
