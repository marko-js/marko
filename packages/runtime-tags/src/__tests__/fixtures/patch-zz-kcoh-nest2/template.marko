<if=input.show>
  <card>
    <const/outer=input.label + "!"/>
    <define/A><b onClick() { console.log(outer) }>${outer}</b></define>
    <card>
      <const/inner=outer + "?"/>
      <define/B><i onClick() { console.log(inner, outer, input.label) }>${inner}</i></define>
      <${input.tag} content=A/>
      <${input.tag} content=B/>
      <card>
        <define/C><u onClick() { console.log(inner, outer) }>${inner}${outer}</u></define>
        <${input.tag} content=C/>
        <${input.tag} content=A/>
      </card>
    </card>
  </card>
</if>
