import { getProduct, getProducts, getRecommendations, getTags } from "./data";

<let/count=0/>
<button.count onClick() { count++ }>clicked ${count}</button>

<define/Cart>
  <shared-list/list name="cart"/>
  <let/products=getProducts?.(list) || []>
  <const/entries=list.map((id) => ({ product: products.find((p) => p.id === id), id }))>
  // A by-less loop over a render-once server-only list: fresh construction
  // must build every branch from the patch (the compute is skipped applying).
  <nav.tags>
    <for|tag| of=getTags?.()>
      // `label` pins transitive taint: a const derived from the stable
      // param must also classify patch-delivered.
      <const/label=tag.toUpperCase()>
      <b class=(tag === $global.tag && "on") data-tag=tag>${label}</b>
    </for>
  </nav>
  <if=!entries.length>
    <p class="cart">cart is empty</p>
  </if>
  <else>
    <ul class="cart">
      <for|entry| of=entries by(entry) { return entry.id }>
        <li>${entry.product.title} $${entry.product.price}</li>
      </for>
    </ul>
    <p class="total">total $${entries.reduce((sum, e) => sum + e.product.price, 0)}</p>
  </else>
</define>
<define/Item>
  <const/product=$global.productId && getProduct($global.productId)>
  <if=!product>
    <h2>not found</h2>
  </if>
  <else>
    <img.thumb src=product.image alt=product.title>
    <h2.title>${product.title}</h2>
    <div.price>$${product.price.toFixed(2)}</div>
    <actions id=product.id/>
    <try>
      <@placeholder>loading recommendations…</@placeholder>
      <await|recs|=getRecommendations(product.id)>
        <ul.recs>
          <for|rec| of=recs by(rec) { return rec.id }>
            <li>${rec.title}</li>
          </for>
        </ul>
      </await>
    </try>
  </else>
</define>

<layout content=$global.view === "item" ? Item : Cart/>
