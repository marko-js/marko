<define/Frame>
  <let/n=0/>
  <html lang="en">
    <head>
      <title>frame</title>
    </head>
    <body>
      <header.frame>STATIC FRAME</header>
      <button onClick() { n++ }>${n}</button>
    </body>
  </html>
</define>
<for|item| of=input.items>
  <li.row>${item}</li>
  <if=input.show>
    <Frame/>
    <span.sibling>sibling</span>
  </if>
</for>
