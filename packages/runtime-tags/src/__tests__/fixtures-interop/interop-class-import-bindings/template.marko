import { Card } from "./named";
import Default, { Card as Mixed, Counter } from "./mixed";
import { Card as Alias, Card as lowercase, default as DefaultAlias } from "./mixed";
import * as Namespace from "./namespace";
import DirectCounter from "./components/tags-counter.marko";

class {
  onCreate() {
    this.state = { count: 0 };
  }
  increment() {
    this.state.count++;
  }
}

<button id="class" onClick("increment")>${state.count}</button>
<Card label="named"/>
<Mixed label="mixed"/>
<Alias label="alias"/>
<lowercase label="lowercase"/>
<Namespace label="namespace"/>
<DefaultAlias label="default alias"/>
<Default label="default"/>
<DirectCounter id="direct" count=state.count/>
<Counter id="named-tags" count=state.count/>
<init-components/>
