// use tags
import { rejectAfter, resolveAfter } from "../../utils/resolve";

<try>
  <@catch>
    <script>console.log("catch effect")</script>
  </@catch>
  <try>
    <@placeholder>loading</@placeholder>
    <await|v|=rejectAfter(new Error("ERROR!"), 1)>${v}</await>
  </try>
</try>
<await|v|=resolveAfter("v", 1)>
  <class-wrap/>
</await>
<await|v|=resolveAfter("slow", 3)>
  <div id="slow">${v}</div>
</await>
