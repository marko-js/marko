import assert from 'assert/strict';

static var counter = 0;

class {
    test(done) {
        var el = this.el;

        assert.equal(el.innerHTML, '0');

        this.onUpdate = function() {
            assert.equal(el.innerHTML, '1');
            done();
        }

        this.forceUpdate();
    }
}

<div>${counter++}</div>
