import hooks from '../../hooks';
import assert from 'assert/strict';

class {
    onDestroy(){
        // The nodes should still be attached
        var rootNode = this.getEl('root');
        assert.equal(rootNode.parentNode != null, true);
        hooks.record('foo:destroy');
    }
}

<div.foo key="root">
	Hello <span.name>${input.name}</span>!
</div>
