import assert from 'assert/strict';

class {
    onCreate() {
        this.clicked = false;
    }

    onMount() {
        var components = window.components || (window.components = {});
        components['no-args'] = this;
    }

	handleButtonClick() {
		this.clicked = true;
	}

    test(helpers) {
        assert.equal(this.clicked, false);
        helpers.triggerMouseEvent(this.getEl('button'), 'click');
        assert.equal(this.clicked, true);
    }
}

<div>
    <button key="button" type="button" on-click('handleButtonClick')>Click me</button>
</div>
