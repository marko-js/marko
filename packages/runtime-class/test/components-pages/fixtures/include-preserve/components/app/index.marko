import assert from 'assert/strict';

class {
    onMount() {
        window.app = this;
    }

    test() {
        assert.equal(this.el.querySelector('.foo section.input').innerHTML, 'Hello Frank');
        assert.equal(this.el.querySelector('.foo section.renderBody').innerHTML, 'Hello Frank');

        var foo = window.app.getComponent('foo');
        foo.forceUpdate();
        foo.update();

        assert.equal(this.el.querySelector('.foo section.input').innerHTML, 'Hello Frank');
        assert.equal(this.el.querySelector('.foo section.renderBody').innerHTML, 'Hello Frank');

        this.input = {
            name: 'John'
        };

        this.update();

        assert.equal(this.el.querySelector('.foo section.input').innerHTML, 'Hello John');
        assert.equal(this.el.querySelector('.foo section.renderBody').innerHTML, 'Hello John');
    }
}

<div>
    <foo key="foo">Hello ${input.name}</foo>
</div>
