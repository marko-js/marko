import assert from 'assert/strict';

class {
    onInput(input) {
        this.state = {
            nameNull: null,
            nameUndefined: undefined
        }
    }

    onMount() {
        window.appStateWatch = this;
    }

    test() {
        assert.equal(this.state.nameNull, null);
        assert.equal(this.state.nameUndefined, undefined);

        this.state.nameNull = 'Frank';
        this.update();
        assert.match(this.el.innerHTML, /nameNull:Frank/);

        this.state.nameUndefined = 'Frank';
        this.update();
        assert.match(this.el.innerHTML, /nameUndefined:Frank/);
    }
}

<div>
    nameNull:${state.nameNull || ''}!
    nameUndefined:${state.nameUndefined || ''}!
</div>