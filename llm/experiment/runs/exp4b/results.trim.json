     "path": "src/routes/+page.marko",
     "content": "<h1>Recipes</h1>\n<input id=\"q\" type=\"text\">\n<div id=\"match-count\">3 shown</div>\n\n<try>\n  <await|recipes|=$global.data.recipes>\n    <ul id=\"recipes\">\n      <for|recipe| of=recipes by=\"id\">\n        <recipe-card recipe=recipe/>\n      </for>\n    </ul>\n  </await>\n  <@placeholder><p>Loading recipes</p></@placeholder>\n</try>\n\n<script>\n  const searchInput = document.getElementById('q');\n  const matchCountEl = document.getElementById('match-count');\n  const recipesList = document.getElementById('recipes');\n\n  function filterRecipes() {\n    const query = searchInput.value.toLowerCase();\n    let visibleCount = 0;\n\n    if (recipesList) {\n      const cards = recipesList.querySelectorAll('li.card');\n      cards.forEach(card => {\n        const titleLink = card.querySelector('a');\n        if (titleLink) {\n          const title = titleLink.textContent.toLowerCase();\n          const isVisible = title.includes(query);\n          card.style.display = isVisible ? '' : 'none';\n          if (isVisible) visibleCount++;\n        }\n      });\n    }\n\n    matchCountEl.textContent = visibleCount + ' shown';\n  }\n\n  searchInput.addEventListener('input', filterRecipes);\n  filterRecipes();\n</script>"
    }
